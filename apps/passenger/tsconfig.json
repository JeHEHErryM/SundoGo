{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@sundogo/auth": ["../../packages/auth/src"],
      "@sundogo/types": ["../../packages/types/src"],
      "@sundogo/ui": ["../../packages/ui/src"],
      "@sundogo/validation": ["../../packages/validation/src"],
      "@sundogo/config": ["../../packages/config/src"]
    }
  },
  "include": ["src"]
}
