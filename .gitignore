# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/

# Turbo
.turbo/

# TypeScript
*.tsbuildinfo

# Generated JS in TS source dirs
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
# Hand-written declarations needed by the build
!apps/*/src/vite-env.d.ts

# Environment files (secrets) — all env files stay local; production
# values live in Vercel/Railway project settings
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

