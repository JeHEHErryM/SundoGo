{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@sundogo/types": ["../../packages/types/src"],
      "@sundogo/validation": ["../../packages/validation/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
